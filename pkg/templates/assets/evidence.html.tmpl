<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="stylesheet" href="styles.css">
<meta name="generator" content="bv {{.GeneratorVersion}} (template=evidence)">
<meta name="color-scheme" content="light dark">
</head>
<body>
<a class="ev-skip" href="#ev-gallery">Skip to gallery</a>
<main class="ev-page">
  <header class="ev-header">
    {{if .Subtitle}}<p class="ev-kicker">{{.Subtitle}}</p>{{end}}
    <h1 class="ev-title">{{.Title}}</h1>
    {{if .Summary}}<p class="ev-summary">{{.Summary}}</p>{{end}}
  </header>
  <fieldset class="ev-layout-control">
    <legend>Layout</legend>
    <input class="ev-layout-input" type="radio" name="ev-layout" id="ev-layout-stacked" checked>
    <label class="ev-layout-label" for="ev-layout-stacked">Stacked</label>
    <input class="ev-layout-input" type="radio" name="ev-layout" id="ev-layout-carousel">
    <label class="ev-layout-label" for="ev-layout-carousel">Carousel</label>
  </fieldset>
  <section class="ev-gallery" id="ev-gallery" aria-label="Evidence gallery">
    <ol class="ev-track" aria-label="Gallery items">
      {{range $i, $it := .Items}}
        <li class="ev-slide" id="item-{{add1 $i}}">
          <figure class="ev-item" tabindex="-1">
            <div class="ev-media">
              {{if $it.IsImage}}
                <img src="assets/{{$it.SafeName}}" alt="{{$it.Alt}}" loading="lazy" decoding="async">
              {{else if $it.IsVideo}}
                <video src="assets/{{$it.SafeName}}" preload="metadata" controls playsinline></video>
              {{end}}
            </div>
            {{if or $it.Title $it.Description}}
              <figcaption class="ev-caption">
                <span class="ev-seq" aria-hidden="true">{{add1 $i}}</span>
                {{if $it.Title}}<h2 class="ev-item-title">{{$it.Title}}</h2>{{end}}
                {{if $it.Description}}<p class="ev-item-desc">{{$it.Description}}</p>{{end}}
              </figcaption>
            {{end}}
          </figure>
        </li>
      {{end}}
    </ol>
    <nav class="ev-pager" aria-label="Gallery pagination">
      {{range $i, $it := .Items}}<a href="#item-{{add1 $i}}" aria-label="Go to item {{add1 $i}}">{{add1 $i}}</a>{{end}}
    </nav>
  </section>
  <footer class="ev-footer">
    <p>Generated by <a href="https://butverify.dev">butverify.dev</a> &middot; template=evidence{{if .GeneratorVersion}} &middot; bv {{.GeneratorVersion}}{{end}}</p>
  </footer>
</main>
</body>
</html>
