<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="stylesheet" href="styles.css">
<meta name="generator" content="bv {{.GeneratorVersion}} (template=evidence)">
<meta name="color-scheme" content="light dark">
</head>
<body>
<a class="ev-skip" href="#ev-gallery">Skip to gallery</a>
<div class="ev-app">
  <header class="ev-topbar">
    <div class="ev-title-row">
      <div class="ev-title-stack">
        {{if .Subtitle}}<p class="ev-kicker">{{.Subtitle}}</p>{{end}}
        <h1 class="ev-title" id="ev-page-title">{{.Title}}</h1>
      </div>
      <button class="ev-meta-toggle" type="button" data-ev-meta-toggle aria-expanded="false" aria-controls="ev-meta-panel">
        <svg class="ev-button-icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5"></path><path d="M12 8h.01"></path></svg>
        <span>Metadata</span>
      </button>
    </div>
    <div class="ev-meta-strip" aria-label="Evidence metadata">
      <span class="ev-meta-chip">{{len .Items}} items</span>
      <span class="ev-meta-chip">template=evidence</span>
      {{if .GeneratorVersion}}<span class="ev-meta-chip">bv {{.GeneratorVersion}}</span>{{end}}
      <fieldset class="ev-layout-control">
        <legend class="ev-sr-only">Layout</legend>
        <input class="ev-layout-input" type="radio" name="ev-layout" id="ev-layout-stacked" value="stacked" checked data-ev-layout>
        <label class="ev-layout-label" for="ev-layout-stacked">
          <svg class="ev-button-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M8 6h12"></path><path d="M8 12h12"></path><path d="M8 18h12"></path><path d="M4 6h.01"></path><path d="M4 12h.01"></path><path d="M4 18h.01"></path></svg>
          <span>Stacked</span>
        </label>
        <input class="ev-layout-input" type="radio" name="ev-layout" id="ev-layout-carousel" value="carousel" data-ev-layout>
        <label class="ev-layout-label" for="ev-layout-carousel">
          <svg class="ev-button-icon" aria-hidden="true" viewBox="0 0 24 24"><rect x="4" y="6" width="16" height="12" rx="2"></rect><path d="M8 3v3"></path><path d="M16 18v3"></path></svg>
          <span>Carousel</span>
        </label>
      </fieldset>
    </div>
  </header>
  <main class="ev-main">
    <aside class="ev-metadata-sidebar" id="ev-meta-panel" aria-labelledby="ev-meta-heading" hidden>
      <div class="ev-sidebar-head">
        <h2 id="ev-meta-heading">Metadata</h2>
        <button class="ev-icon-button" type="button" data-ev-meta-close aria-label="Close metadata">
          <svg class="ev-button-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
          <span>Close</span>
        </button>
      </div>
      <dl class="ev-meta-list">
        <div><dt>Title</dt><dd>{{.Title}}</dd></div>
        {{if .Subtitle}}<div><dt>Subtitle</dt><dd>{{.Subtitle}}</dd></div>{{end}}
        <div><dt>Items</dt><dd>{{len .Items}}</dd></div>
        <div><dt>Template</dt><dd>evidence</dd></div>
        {{if .GeneratorVersion}}<div><dt>Generator</dt><dd>bv {{.GeneratorVersion}}</dd></div>{{end}}
      </dl>
      {{if .Summary}}
        <section class="ev-meta-summary" aria-labelledby="ev-summary-heading">
          <h3 id="ev-summary-heading">Summary</h3>
          <p>{{.Summary}}</p>
        </section>
      {{end}}
      <p class="ev-generated">Generated by <a href="https://butverify.dev">butverify.dev</a></p>
    </aside>
    <section class="ev-content-panel" id="ev-gallery" aria-labelledby="ev-page-title">
      <aside class="ev-outline" data-ev-outline aria-label="Evidence outline">
        <div class="ev-outline-head">
          <button class="ev-outline-toggle" type="button" data-ev-outline-toggle aria-expanded="true" aria-controls="ev-outline-list">
            <svg class="ev-button-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path></svg>
            <span class="ev-outline-label">Outline</span>
          </button>
        </div>
        <nav class="ev-outline-nav" id="ev-outline-list">
          {{range $i, $it := .Items}}
            <a class="ev-outline-link" href="#item-{{add1 $i}}" data-ev-outline-link data-ev-index="{{$i}}">
              <span class="ev-outline-index">{{add1 $i}}</span>
              <span class="ev-outline-title">{{if $it.Title}}{{$it.Title}}{{else}}Item {{add1 $i}}{{end}}</span>
            </a>
          {{end}}
        </nav>
      </aside>
      <section class="ev-gallery-panel" aria-label="Evidence items">
        <div class="ev-panel-toolbar">
          <h2>Evidence</h2>
          <div class="ev-carousel-actions" aria-label="Carousel controls">
            <button class="ev-step-button" type="button" data-ev-prev>
              <svg class="ev-button-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"></path></svg>
              <span>Previous</span>
            </button>
            <button class="ev-step-button" type="button" data-ev-next>
              <span>Next</span>
              <svg class="ev-button-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"></path></svg>
            </button>
          </div>
        </div>
        <div class="ev-gallery-viewport" data-ev-gallery-viewport tabindex="0">
          <ol class="ev-track" aria-label="Gallery items">
            {{range $i, $it := .Items}}
              <li class="ev-slide" id="item-{{add1 $i}}" data-ev-slide data-ev-index="{{$i}}">
                <figure class="ev-item" tabindex="-1">
                  <div class="ev-media">
                    {{if $it.IsImage}}
                      <img src="assets/{{$it.SafeName}}" alt="{{$it.Alt}}" loading="lazy" decoding="async">
                    {{else if $it.IsVideo}}
                      <video src="assets/{{$it.SafeName}}" preload="metadata" controls playsinline></video>
                    {{end}}
                  </div>
                  {{if or $it.Title $it.Description}}
                    <figcaption class="ev-caption">
                      <span class="ev-seq" aria-hidden="true">{{add1 $i}}</span>
                      {{if $it.Title}}<h3 class="ev-item-title">{{$it.Title}}</h3>{{end}}
                      {{if $it.Description}}<p class="ev-item-desc">{{$it.Description}}</p>{{end}}
                    </figcaption>
                  {{end}}
                </figure>
              </li>
            {{end}}
          </ol>
        </div>
        <nav class="ev-pager" aria-label="Carousel pages">
          {{range $i, $it := .Items}}<button class="ev-page-button" type="button" data-ev-page data-ev-index="{{$i}}" aria-label="Go to item {{add1 $i}}"><svg class="ev-page-icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"></circle></svg><span>{{add1 $i}}</span></button>{{end}}
        </nav>
      </section>
    </section>
  </main>
</div>
<script src="evidence.js" defer></script>
</body>
</html>
