<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="stylesheet" href="assets/styles.css">
<meta name="generator" content="bv {{.GeneratorVersion}} (template=dashboard)">
</head>
<body>
<main class="bv-page">
  <header class="bv-header">
    <h1 class="bv-title">{{.Title}}</h1>
    {{if .Subtitle}}<p class="bv-subtitle">{{.Subtitle}}</p>{{end}}
  </header>

  {{if .Stats}}
  <section class="bv-section">
    <h2 class="bv-section-title">Summary</h2>
    <div class="bv-stats">
      {{range .Stats}}
        <div class="bv-stat">
          <div class="bv-stat-label">{{.Label}}</div>
          <div class="bv-stat-value">{{.Value}}</div>
        </div>
      {{end}}
    </div>
  </section>
  {{end}}

  {{range .Charts}}
  <section class="bv-section">
    <h2 class="bv-section-title">{{.Title}}</h2>
    <div class="bv-chart">{{.SVG}}</div>
  </section>
  {{end}}

  <section class="bv-section">
    <h2 class="bv-section-title">Data ({{.RowCount}} rows)</h2>
    <table class="bv-table">
      <thead><tr>{{range .Columns}}<th>{{.}}</th>{{end}}</tr></thead>
      <tbody>
        {{range .Rows}}<tr>{{range .}}<td>{{.}}</td>{{end}}</tr>{{end}}
      </tbody>
    </table>
    {{if .Truncated}}<p class="bv-text" style="margin-top:12px;color:var(--bv-fg-muted);">
      Showing first {{.RowsShown}} of {{.RowCount}} rows. Download <a href="data.csv">data.csv</a> for the complete dataset.
    </p>{{end}}
  </section>

  <footer class="bv-footer">
    Generated by <a href="https://butverify.dev">butverify.dev</a> · template=dashboard · {{.GeneratedAt}}
  </footer>
</main>
</body>
</html>
