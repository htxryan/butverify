<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="stylesheet" href="assets/styles.css">
<meta name="generator" content="bv {{.GeneratorVersion}} (template=report)">
</head>
<body>
<main class="bv-page">
  <header class="bv-header">
    <h1 class="bv-title">{{.Title}}</h1>
    {{if .Subtitle}}<p class="bv-subtitle">{{.Subtitle}}</p>{{end}}
  </header>
  {{range .Sections}}
    {{if eq .Type "headline"}}
      <div class="bv-headline tone-{{or .Tone "info"}}">{{.Text}}</div>
    {{else if eq .Type "kv"}}
      <section class="bv-section">
        {{if .Title}}<h2 class="bv-section-title">{{.Title}}</h2>{{end}}
        <div class="bv-kv">
          {{range .Items}}
            <div class="bv-kv-row">
              <div class="bv-kv-key">{{.Key}}</div>
              <div class="bv-kv-val">{{.Value}}</div>
            </div>
          {{end}}
        </div>
      </section>
    {{else if eq .Type "table"}}
      <section class="bv-section">
        {{if .Title}}<h2 class="bv-section-title">{{.Title}}</h2>{{end}}
        <table class="bv-table">
          <thead><tr>{{range .Columns}}<th>{{.}}</th>{{end}}</tr></thead>
          <tbody>
            {{range .Rows}}<tr>{{range .}}<td>{{.}}</td>{{end}}</tr>{{end}}
          </tbody>
        </table>
      </section>
    {{else if eq .Type "code"}}
      <section class="bv-section">
        {{if .Title}}<h2 class="bv-section-title">{{.Title}}{{if .Language}} · {{.Language}}{{end}}</h2>{{end}}
        <pre class="bv-code"><code>{{.Code}}</code></pre>
      </section>
    {{else if eq .Type "diff"}}
      <section class="bv-section">
        {{if .Title}}<h2 class="bv-section-title">{{.Title}}</h2>{{end}}
        <div class="bv-diff">
          {{range .DiffLines}}<div class="bv-diff-line {{.Cls}}">{{.Text}}</div>{{end}}
        </div>
      </section>
    {{else if eq .Type "text"}}
      <section class="bv-section">
        {{if .Title}}<h2 class="bv-section-title">{{.Title}}</h2>{{end}}
        <div class="bv-text">{{.Body}}</div>
      </section>
    {{end}}
  {{end}}
  <footer class="bv-footer">
    Generated by <a href="https://butverify.dev">butverify.dev</a> · template=report · {{.GeneratedAt}}
  </footer>
</main>
</body>
</html>
