# Marketing site build-time env. Cloudflare Pages reads these at build.
# Without PUBLIC_POSTHOG_KEY the analytics snippet is omitted from <head>.

PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
PUBLIC_GH_APP_INSTALL_URL=https://github.com/apps/butverify/installations/new
SITE_URL=https://butverify.dev
