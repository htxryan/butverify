---
interface Props {
  class?: string;
  size?: number;
}
const { class: className = "", size = 24 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <circle cx="12" cy="12" r="9"></circle>
  <circle cx="12" cy="12" r="5.5"></circle>
  <circle cx="12" cy="12" r="1.8" fill="currentColor" stroke="none"></circle>
</svg>
