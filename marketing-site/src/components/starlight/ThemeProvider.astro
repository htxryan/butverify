---
/* Override Starlight's ThemeProvider so /docs defaults to DARK (matching the
 * marketing site) instead of falling back to `prefers-color-scheme`. The
 * stock provider returns 'dark' only when the OS reports a non-light
 * preference; many environments (incl. headless Chromium and macOS users
 * who never opted in to dark mode) report 'light', causing a jarring
 * theme flip when crossing from butverify.dev → /docs. The user's explicit
 * choice via the theme picker still wins because we honor `localStorage`.
 *
 * SVG paths for the picker icons are inlined to avoid importing Starlight's
 * private `user-components/Icon.astro` (it isn't in the package exports
 * map). They're copied verbatim from
 * `@astrojs/starlight/components/Icons.ts`. */
---

{/* This is intentionally inlined to avoid FOUC. */}
<script is:inline>
  window.StarlightThemeProvider = (() => {
    const storedTheme =
      typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
    /* Match ThemeSelect.astro: unset/empty → brand default 'dark',
     * 'auto' → respect prefers-color-scheme, 'dark'/'light' → as-is. */
    let theme;
    if (storedTheme === 'auto') {
      theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    } else if (storedTheme === 'light' || storedTheme === 'dark') {
      theme = storedTheme;
    } else {
      theme = 'dark';
    }
    document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
    return {
      updatePickers(theme = storedTheme || 'auto') {
        document.querySelectorAll('starlight-theme-select').forEach((picker) => {
          const select = picker.querySelector('select');
          if (select) select.value = theme;
          /** @type {HTMLTemplateElement | null} */
          const tmpl = document.querySelector(`#theme-icons`);
          const newIcon = tmpl && tmpl.content.querySelector('.' + theme);
          if (newIcon) {
            const oldIcon = picker.querySelector('svg.label-icon');
            if (oldIcon) {
              oldIcon.replaceChildren(...newIcon.cloneNode(true).childNodes);
            }
          }
        });
      },
    };
  })();
</script>

<template id="theme-icons">
