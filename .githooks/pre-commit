#!/bin/sh
set -eu

doc_paths="marketing-site/src/content/docs/docs/reference/cli.md marketing-site/src/content/docs/docs/reference/api.md"

task docs:generate

if ! git diff --quiet -- $doc_paths; then
	git add $doc_paths
	printf '%s\n' "Generated reference docs changed and were staged. Review them, then rerun commit."
	exit 1
fi
